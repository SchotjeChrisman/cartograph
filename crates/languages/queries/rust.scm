; What to look for in Rust. The Rust side names things and tracks scopes; the capture name says
; only which kind of syntax matched.
(mod_item) @module
(struct_item) @class
(enum_item) @class
(union_item) @class
(trait_item) @trait
(type_item) @type
(impl_item) @impl
(function_item) @function
(use_declaration) @use
(call_expression) @call
